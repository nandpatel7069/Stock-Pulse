# =====================================================================
# StockPulse - Environment Configuration Template
# Copy this file to .env and configure with your local database credentials
# =====================================================================

# Option A: MySQL Server & MySQL Workbench Configuration (Default)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=retail_db
DATABASE_URL=mysql://root:your_mysql_password@localhost:3306/retail_db

# Option B: PostgreSQL Configuration (Alternative)
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/retail_db
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgrespassword
# PGDATABASE=retail_db

# Security & JWT Auth
JWT_SECRET=stockpulse_jwt_secret_super_secure_key_2026_DBMS

# Application Config
NEXT_PUBLIC_APP_NAME=StockPulse
PORT=3000
